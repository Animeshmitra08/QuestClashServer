{
  "name": "questclash-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative multiplayer server for QuestClash (Colyseus). Runs and deploys independently of the Expo app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.19",
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4"
  }
}
